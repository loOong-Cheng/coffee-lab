{
  "name": "coffee-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Coffee Lab / 咖啡实验室 — beginner-first coffee learning game (Desktop 2D, Mobile real-world guide, optional WebXR).",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "npm run typecheck && vite build",
    "build:vite": "vite build",
    "preview": "vite preview",
    "preview:lan": "vite build && vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:serve": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@babylonjs/gui": "^9.35.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
